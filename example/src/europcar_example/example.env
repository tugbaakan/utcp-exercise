# Europcar API Configuration Template
# Copy this file to .env and fill in your actual values

# Required: API Authentication (Bearer token)
EUROPCAR_API_API_KEY=your_api_key_or_bearer_token_here

# Optional: Culture/Language setting (tr = Turkish, en = English)
EUROPCAR_API_X_CULTURE=en

# Optional: API Base URL (already configured in OpenAPI spec)
EUROPCAR_API_BASE_URL=https://europcar-api.nuevotest.com

# Debug mode (set to true for verbose logging)
DEBUG=false

# Request timeout (in seconds)
EUROPCAR_REQUEST_TIMEOUT=30

# OpenAI API Configuration (required for LLM example)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here